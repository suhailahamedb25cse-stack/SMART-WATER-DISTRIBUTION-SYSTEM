digraph Domain {
rankdir=BT; nodesep=0.45; ranksep=0.7; splines=polyline; labelloc=t; fontsize=20; fontname="Helvetica-Bold";
label="Smart Water Distribution - UML class diagram (domain model)\n";
node [shape=plain fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=10];
DemandArea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER"><B><I>DemandArea</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: String</TD></TR><TR><TD ALIGN="LEFT">- name: String</TD></TR><TR><TD ALIGN="LEFT">- dailyDemand: double</TD></TR><TR><TD ALIGN="LEFT">- unmetDemand: double</TD></TR><TR><TD ALIGN="LEFT">- sources: HashMap&lt;String, Double&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT"><I>+ allocationPriority(): int</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getAreaType(): String</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getDetails(): String</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ withDemand(newDemand: double): DemandArea</I></TD></TR><TR><TD ALIGN="LEFT">+ getPriority(): Priority</TD></TR><TR><TD ALIGN="LEFT">+ receiveAllocation(litres: double)</TD></TR><TR><TD ALIGN="LEFT">+ resetDailyDemand()</TD></TR><TR><TD ALIGN="LEFT">+ getMainSource(): String</TD></TR></TABLE>>];
CriticalInstitution [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e0f4f3"><TR><TD ALIGN="CENTER"><B>CriticalInstitution</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- institutionType: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ allocationPriority(): int  // always 0</TD></TR><TR><TD ALIGN="LEFT">+ getAreaType(): String</TD></TR><TR><TD ALIGN="LEFT">+ getDetails(): String</TD></TR><TR><TD ALIGN="LEFT">+ withDemand(d: double): DemandArea</TD></TR></TABLE>>];
ResidentialArea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e3f0fc"><TR><TD ALIGN="CENTER"><B>ResidentialArea</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- priority: Priority  // HIGH or NORMAL</TD></TR><TR><TD ALIGN="LEFT">- households: int</TD></TR><HR/><TR><TD ALIGN="LEFT">+ allocationPriority(): int  // 1 or 2</TD></TR><TR><TD ALIGN="LEFT">+ getAreaType(): String</TD></TR><TR><TD ALIGN="LEFT">+ getDetails(): String</TD></TR><TR><TD ALIGN="LEFT">+ withDemand(d: double): DemandArea</TD></TR></TABLE>>];
WaterAllocationPolicy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">&laquo;implements Comparator&lt;WaterRequest&gt;&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>WaterAllocationPolicy</I></B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><I>+ compare(a: WaterRequest, b: WaterRequest): int</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getName(): String</I></TD></TR></TABLE>>];
PriorityAllocationPolicy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>PriorityAllocationPolicy</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ compare(a: WaterRequest, b: WaterRequest): int</TD></TR><TR><TD ALIGN="LEFT">+ getName(): String</TD></TR></TABLE>>];
WaterRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>WaterRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- area: DemandArea</TD></TR><TR><TD ALIGN="LEFT">- litres: double</TD></TR><TR><TD ALIGN="LEFT">- arrivalOrder: int</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
WaterNetwork [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f3e5f5"><TR><TD ALIGN="CENTER"><B>WaterNetwork</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- reservoirs: TreeMap&lt;String, Reservoir&gt;</TD></TR><TR><TD ALIGN="LEFT">- demandAreas: TreeMap&lt;String, DemandArea&gt;</TD></TR><TR><TD ALIGN="LEFT">- adjacencyList: HashMap&lt;String, List&lt;Pipeline&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">- allPipelines: List&lt;Pipeline&gt;</TD></TR><TR><TD ALIGN="LEFT">- policy: WaterAllocationPolicy</TD></TR><HR/><TR><TD ALIGN="LEFT">+ findReachableAreas(reservoirId: String): List&lt;String&gt;   // BFS</TD></TR><TR><TD ALIGN="LEFT">+ bfsPath(startId: String, targetId: String): List&lt;String&gt;   // BFS</TD></TR><TR><TD ALIGN="LEFT">+ findSupplyPath(area: DemandArea): List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT">+ findDisconnectedAreas(): List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT">+ recalculate()   // PriorityQueue allocation</TD></TR><TR><TD ALIGN="LEFT">+ getAreaStatus(area: DemandArea, cutOff: List&lt;String&gt;): String</TD></TR><TR><TD ALIGN="LEFT">+ addReservoir(r) / addDemandArea(a) / addPipeline(p)</TD></TR><TR><TD ALIGN="LEFT">+ removeNode(id) / removePipeline(id)</TD></TR></TABLE>>];
Reservoir [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>Reservoir</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: String</TD></TR><TR><TD ALIGN="LEFT">- name: String</TD></TR><TR><TD ALIGN="LEFT">- capacity: double</TD></TR><TR><TD ALIGN="LEFT">- remaining: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ allocateWater(requested: double): double</TD></TR><TR><TD ALIGN="LEFT">+ resetDailySupply()</TD></TR><TR><TD ALIGN="LEFT">+ setCapacity(c: double)</TD></TR></TABLE>>];
Pipeline [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>Pipeline</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: String</TD></TR><TR><TD ALIGN="LEFT">- node1: String</TD></TR><TR><TD ALIGN="LEFT">- node2: String</TD></TR><TR><TD ALIGN="LEFT">- working: boolean</TD></TR><HR/><TR><TD ALIGN="LEFT">+ markFailed()</TD></TR><TR><TD ALIGN="LEFT">+ markWorking()</TD></TR><TR><TD ALIGN="LEFT">+ isWorking(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ getOtherEnd(node: String): String</TD></TR></TABLE>>];
MaintenanceRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>MaintenanceRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- pipelineId: String</TD></TR><TR><TD ALIGN="LEFT">- description: String</TD></TR><TR><TD ALIGN="LEFT">- status: Status  // PENDING, IN_PROGRESS, DONE, CANCELLED</TD></TR><TR><TD ALIGN="LEFT">- createdTime, startedTime, completedTime: String</TD></TR><TR><TD ALIGN="LEFT">- createdBy: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ setStatus(s: Status)</TD></TR><TR><TD ALIGN="LEFT">+ now(): String  {static}</TD></TR></TABLE>>];
MaintenanceQueue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffebee"><TR><TD ALIGN="CENTER"><B>MaintenanceQueue</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- pending: ArrayDeque&lt;MaintenanceRequest&gt;   // FIFO</TD></TR><TR><TD ALIGN="LEFT">- current: MaintenanceRequest</TD></TR><TR><TD ALIGN="LEFT">- history: ArrayList&lt;MaintenanceRequest&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT">+ addPending(r: MaintenanceRequest)   // joins the back</TD></TR><TR><TD ALIGN="LEFT">+ startNext(): MaintenanceRequest   // takes the front</TD></TR><TR><TD ALIGN="LEFT">+ completeCurrent(): MaintenanceRequest</TD></TR><TR><TD ALIGN="LEFT">+ cancelFor(pipelineId: String): MaintenanceRequest</TD></TR><TR><TD ALIGN="LEFT">+ hasOpenRequestFor(pipelineId: String): boolean</TD></TR></TABLE>>];
AllocationRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>AllocationRecord</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- time: String</TD></TR><TR><TD ALIGN="LEFT">- day: int</TD></TR><TR><TD ALIGN="LEFT">- trigger: String</TD></TR><TR><TD ALIGN="LEFT">- totalAvailable, totalAllocated, totalUnmet: double</TD></TR><TR><TD ALIGN="LEFT">- lines: List&lt;Line&gt;   // what each area received</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
AllocationHistory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><B>AllocationHistory</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- records: ArrayList&lt;AllocationRecord&gt;   // newest first</TD></TR><HR/><TR><TD ALIGN="LEFT">+ addNewest(r: AllocationRecord)</TD></TR><TR><TD ALIGN="LEFT">+ getRecords(): List&lt;AllocationRecord&gt;</TD></TR></TABLE>>];
CriticalInstitution -> DemandArea [arrowhead=empty, color="#333333"];
ResidentialArea -> DemandArea [arrowhead=empty, color="#333333"];
PriorityAllocationPolicy -> WaterAllocationPolicy [arrowhead=empty, color="#333333"];
Reservoir -> WaterNetwork [arrowhead=diamond, dir=forward, label="  1..*", color="#333333"];
DemandArea -> WaterNetwork [arrowhead=diamond, dir=forward, label="  1..*", color="#333333"];
Pipeline -> WaterNetwork [arrowhead=diamond, dir=forward, label="  0..*", color="#333333"];
WaterAllocationPolicy -> WaterNetwork [arrowhead=odiamond, dir=forward, label="  uses 1", color="#333333"];
WaterRequest -> WaterNetwork [style=dashed, arrowhead=open, dir=forward, label="  <<creates>>", color="#555555"];
WaterRequest -> DemandArea [arrowhead=open, label="  area 1", color="#333333"];
MaintenanceRequest -> MaintenanceQueue [arrowhead=diamond, dir=forward, label="  0..*", color="#333333"];
MaintenanceRequest -> Pipeline [style=dashed, arrowhead=open, label="  <<repairs>>", color="#555555"];
AllocationRecord -> AllocationHistory [arrowhead=diamond, dir=forward, label="  0..50", color="#333333"];

Legend [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fafafa">
<TR><TD ALIGN="LEFT"><B>How to read it</B></TD></TR>
<TR><TD ALIGN="LEFT">hollow triangle = inheritance (is a)</TD></TR>
<TR><TD ALIGN="LEFT">filled diamond = composition (is made of)</TD></TR>
<TR><TD ALIGN="LEFT">hollow diamond = aggregation (uses)</TD></TR>
<TR><TD ALIGN="LEFT">dashed arrow = dependency</TD></TR>
<TR><TD ALIGN="LEFT">italic name = abstract class / method</TD></TR></TABLE>>];
}
